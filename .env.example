# Database
POSTGRES_USER=factory
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=factory

# API
API_PORT=8000
API_KEY=

# Dashboard
DASHBOARD_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Orchestrator
WORKSPACE_ROOT=/data/workspaces
INTAKE_FORM_TIMEOUT_HOURS=72
# Fernet key for encrypting project secrets at rest (generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
SECRETS_ENCRYPTION_KEY=

# Live preview URLs shown in the dashboard (hostname or full origin, without port)
PREVIEW_HOST=localhost

# Optional: factory-level Cursor API key (users can also connect via dashboard)
# CURSOR_API_KEY=
