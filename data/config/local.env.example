# Optional local overrides (loaded on factory startup).
# Copy to ${FACTORY_DATA:-./data}/config/local.env and uncomment any lines you need.
# Values here do not override variables already set in the container environment.

# FACTORY_DATA=/mnt/factory
# PUBLIC_HOST=factory.example.com
# HTTP_PORT=8044
# AGENT_BACKEND=cursor_cloud
# CURSOR_API_KEY=crsr_...
# GITHUB_TOKEN=ghp_...   # optional — or connect GitHub in the dashboard Cursor menu
# API_KEY=your-factory-api-key

# Generate your own encryption key (optional — auto-generated if omitted):
# SECRETS_ENCRYPTION_KEY=

# Verification & measurement (defaults shown):
# ADVERSARY_ENABLED=true            # adversarial verification before acceptance
# AGENT_TESTER_ENABLED=true         # LLM tester writes tests/acceptance/ when available
# DEPLOY_OBSERVATION_SECONDS=30     # post-deploy health window before auto-rollback
# CHANGE_BUDGET_FILES=8             # soft change budget (justification required above)
# CHANGE_BUDGET_LINES=500
# PREVIEW_MEMORY_LIMIT=768m         # resource caps for preview containers ("" disables)
# PREVIEW_CPUS=1.0
# PREVIEW_PIDS_LIMIT=256
